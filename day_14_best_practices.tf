# ╔══════════════════════════════════════════════════════════════════════════════╗
#  Day 14 - Terraform Best Practices
# ╠══════════════════════════════════════════════════════════════════════════════╣
#  Applies to any team or project size. Following these practices prevents
#  the most common Terraform mistakes: state corruption, secret exposure,
#  configuration drift, and unreviewed destructive changes.
# ╚══════════════════════════════════════════════════════════════════════════════╝

terraform {
  required_version = ">= 1.6.0"
  required_providers {
    local  = { source = "hashicorp/local",  version = "~> 2.4" }
    random = { source = "hashicorp/random", version = "~> 3.6" }
  }
}
provider "local" {}
provider "random" {}

# ─────────────────────────────────────────────────────────────────────────────
# BEST PRACTICE 1: FILE STRUCTURE — one concern per file
# ─────────────────────────────────────────────────────────────────────────────
# myproject/
# ├── main.tf           ← primary resources
# ├── variables.tf      ← all input variable declarations
# ├── outputs.tf        ← all output declarations
# ├── providers.tf      ← provider config + required_providers + backend
# ├── locals.tf         ← local values
# ├── data.tf           ← data source definitions
# ├── versions.tf       ← terraform {} block only
# ├── terraform.tfvars  ← variable values (DO NOT commit if secrets)
# └── README.md         ← how to use this config

# ─────────────────────────────────────────────────────────────────────────────
# BEST PRACTICE 2: NAMING CONVENTIONS
# ─────────────────────────────────────────────────────────────────────────────
# Resources: snake_case, descriptive
#   aws_instance.web_server    ✔
#   aws_instance.ws1           ✗  (not descriptive)
#   aws_instance.WebServer     ✗  (not snake_case)
#
# Variables: snake_case, descriptive
#   variable "enable_monitoring" {}    ✔
#   variable "mon"  {}                 ✗
#
# Locals: snake_case
#   locals { name_prefix = "..." }     ✔
#
# Outputs: snake_case, describe the value
#   output "web_server_public_ip" {}   ✔
#   output "ip" {}                     ✗

# ─────────────────────────────────────────────────────────────────────────────
# BEST PRACTICE 3: .gitignore — never commit these
# ─────────────────────────────────────────────────────────────────────────────
# Create .gitignore in every Terraform project:
#
# .terraform/              ← provider binaries (large, regenerated by init)
# .terraform.lock.hcl     ← EXCEPTION: DO commit this (pins provider versions)
# terraform.tfstate        ← state file (use remote backend instead)
# terraform.tfstate.backup ← state backup
# *.tfvars                 ← may contain secrets (or list specific files)
# .terraform.tfvars        ← never commit
# crash.log                ← Terraform crash logs
# override.tf              ← local overrides
# override.tf.json
# *_override.tf

# ─────────────────────────────────────────────────────────────────────────────
# BEST PRACTICE 4: VARIABLE VALIDATION
# ─────────────────────────────────────────────────────────────────────────────

variable "environment" {
  type        = string
  description = "Deployment environment"
  validation {
    condition     = contains(["dev", "staging", "prod"], var.environment)
    error_message = "Must be dev, staging, or prod."
  }
}

variable "instance_count" {
  type        = number
  description = "Number of instances (1–10)"
  default     = 1
  validation {
    condition     = var.instance_count >= 1 && var.instance_count <= 10
    error_message = "Must be between 1 and 10."
  }
}

variable "cidr_block" {
  type        = string
  description = "VPC CIDR block"
  default     = "10.0.0.0/16"
  validation {
    condition     = can(cidrhost(var.cidr_block, 0))
    error_message = "Must be a valid CIDR block (e.g. 10.0.0.0/16)."
  }
}

# ─────────────────────────────────────────────────────────────────────────────
# BEST PRACTICE 5: LIFECYCLE RULES FOR CRITICAL RESOURCES
# ─────────────────────────────────────────────────────────────────────────────

resource "random_id" "critical_id" {
  byte_length = 8
  lifecycle {
    prevent_destroy       = false  # Set true for production databases!
    create_before_destroy = true   # New resource before deleting old
    ignore_changes        = []     # List attributes to ignore on change
  }
}

# ─────────────────────────────────────────────────────────────────────────────
# BEST PRACTICE 6: SENSITIVE VARIABLES — never hardcode secrets
# ─────────────────────────────────────────────────────────────────────────────

variable "db_password" {
  type        = string
  sensitive   = true
  description = "Database password. Set via TF_VAR_db_password env var."
  # NEVER put a default here in production
  # Set via: export TF_VAR_db_password="$(vault kv get -field=password secret/db)"
  default = "demo-only-change-in-production"
}

# ─────────────────────────────────────────────────────────────────────────────
# BEST PRACTICE 7: LOCALS FOR COMPUTED VALUES (not raw variables)
# ─────────────────────────────────────────────────────────────────────────────

locals {
  is_prod      = var.environment == "prod"
  name_prefix  = "${var.environment}-myapp"
  common_tags = {
    Environment = var.environment
    ManagedBy   = "terraform"
    CreatedAt   = timestamp()
  }
  # Compute environment-specific values once, reuse everywhere
  min_instances = local.is_prod ? 2 : 1
  max_instances = local.is_prod ? 10 : 3
}

# ─────────────────────────────────────────────────────────────────────────────
# BEST PRACTICE 8: USE DATA SOURCES OVER HARDCODED VALUES
# ─────────────────────────────────────────────────────────────────────────────
# ✗ Bad:  ami = "ami-0123456789abcdef0"  ← breaks when AMI is deprecated
# ✔ Good: ami = data.aws_ami.latest.id   ← always uses latest

# data "aws_ami" "latest" {
#   most_recent = true
#   owners      = ["amazon"]
#   filter { name = "name"; values = ["al2023-ami-*"] }
# }

# ─────────────────────────────────────────────────────────────────────────────
# BEST PRACTICE 9: DOCUMENT WITH DESCRIPTIONS
# ─────────────────────────────────────────────────────────────────────────────
# Every variable, output, and resource should have a meaningful description.
# This becomes the documentation for your module.

resource "local_file" "best_practices_guide" {
  filename = "${path.module}/BEST_PRACTICES.md"
  content  = <<-MD
    # Terraform Best Practices

    ## File Structure
    - main.tf, variables.tf, outputs.tf, providers.tf, locals.tf

    ## Security
    - Never commit state files or .tfvars with secrets
    - Mark sensitive variables with `sensitive = true`
    - Use remote backend with encryption for state
    - Use `prevent_destroy = true` for production databases

    ## Code Quality
    - Run `terraform fmt` before every commit
    - Run `terraform validate` in CI
    - Use `checkov` or `tfsec` for security scanning
    - Pin provider versions with `~>` constraints
    - Commit `.terraform.lock.hcl`

    ## Workflow
    - ALWAYS review `terraform plan` before `apply`
    - Use `-out=tfplan` in CI, apply the saved plan
    - Use workspaces or directories for environment separation
    - Use `terraform import` to adopt existing resources

    ## Naming
    - snake_case for all identifiers
    - Descriptive names: `web_server` not `ws1`
    - Include environment in resource names when relevant
  MD
  file_permission = "0644"
}

output "env_is_prod"   { value = local.is_prod }
output "name_prefix"   { value = local.name_prefix }
output "guide_path"    { value = local_file.best_practices_guide.filename }
