# ╔══════════════════════════════════════════════════════════════════════════════╗
#  Day 10 - Workspaces
# ╠══════════════════════════════════════════════════════════════════════════════╣
#  WHAT ARE WORKSPACES?
#  Workspaces allow you to maintain MULTIPLE STATE FILES from a single
#  Terraform configuration. Each workspace has its own isolated state.
#
#  USE CASES:
#   - Manage dev/staging/prod with the same config
#   - Test changes in isolation before promoting to production
#   - Per-feature-branch infrastructure
#
#  BUILT-IN VARIABLE:
#   terraform.workspace — the name of the current workspace ("default" if none)
#
#  COMMANDS:
#   terraform workspace list       — list all workspaces (* = current)
#   terraform workspace new dev    — create and switch to "dev" workspace
#   terraform workspace select prod — switch to "prod" workspace
#   terraform workspace show       — show current workspace name
#   terraform workspace delete dev  — delete a workspace (must be empty)
#
#  WORKSPACE vs SEPARATE DIRS:
#   Workspaces: same config, isolated state — good for environments
#   Separate dirs: fully separate configs — better for truly different infra
#   Many teams prefer separate dirs + modules for better isolation.
# ╚══════════════════════════════════════════════════════════════════════════════╝

terraform {
  required_version = ">= 1.6.0"
  required_providers {
    local  = { source = "hashicorp/local",  version = "~> 2.4" }
    random = { source = "hashicorp/random", version = "~> 3.6" }
  }
}
provider "local" {}
provider "random" {}

# ─────────────────────────────────────────────────────────────────────────────
# terraform.workspace — access the current workspace name
# ─────────────────────────────────────────────────────────────────────────────

locals {
  # Use workspace name as environment indicator
  env = terraform.workspace   # "default", "dev", "staging", "prod"

  # Workspace-specific configuration using lookup
  workspace_config = {
    default = {
      replicas      = 1
      instance_type = "t3.micro"
      log_level     = "debug"
      retention_days = 3
    }
    dev = {
      replicas      = 1
      instance_type = "t3.micro"
      log_level     = "debug"
      retention_days = 7
    }
    staging = {
      replicas      = 2
      instance_type = "t3.small"
      log_level     = "info"
      retention_days = 30
    }
    prod = {
      replicas      = 3
      instance_type = "t3.large"
      log_level     = "warn"
      retention_days = 90
    }
  }

  # Select config for current workspace (fallback to "default" if unknown)
  config = lookup(local.workspace_config, local.env, local.workspace_config["default"])

  is_prod       = local.env == "prod"
  name_prefix   = "myapp-${local.env}"
}

resource "random_id" "workspace_id" { byte_length = 4 }

resource "local_file" "workspace_config" {
  filename = "${path.module}/workspace-${local.env}-config.yaml"
  content  = <<-YAML
    # Workspace: ${local.env}
    # Generated by Terraform
    workspace: ${local.env}
    workspace_id: ${random_id.workspace_id.hex}
    name_prefix: ${local.name_prefix}
    is_production: ${local.is_prod}

    compute:
      instance_type: ${local.config.instance_type}
      replicas: ${local.config.replicas}

    logging:
      level: ${local.config.log_level}
      retention_days: ${local.config.retention_days}
  YAML
  file_permission = "0644"
}

output "current_workspace"  { value = terraform.workspace }
output "environment_config" { value = local.config }
output "is_production"      { value = local.is_prod }
output "config_file"        { value = local_file.workspace_config.filename }

# ─────────────────────────────────────────────────────────────────────────────
# WORKSPACE WORKFLOW (run in terminal):
# ─────────────────────────────────────────────────────────────────────────────
# terraform workspace list              ← shows: * default
# terraform workspace new dev           ← creates + switches to "dev"
# terraform apply                       ← applies in "dev" workspace
# terraform workspace new staging       ← creates "staging"
# terraform apply                       ← separate state from "dev"
# terraform workspace select dev        ← switch back to dev
# terraform output current_workspace    ← shows "dev"
# terraform workspace select default    ← back to default
# terraform workspace delete staging    ← delete empty workspace
